# --- build stage -----------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

# Pin pnpm to the version the lockfile was generated with.
RUN npm install -g pnpm@11.5.2

# Install dependencies first for better layer caching.
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY web/ .

# The Nitro proxy (web/server/routes/v1/[...].ts) reads NUXT_API_BASE at
# runtime, but we also bake the containerized default in at build time.
ARG NUXT_API_BASE=http://api:8080
ENV NUXT_API_BASE=$NUXT_API_BASE
RUN pnpm build

# --- runtime stage ---------------------------------------------------------
FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NUXT_API_BASE=http://api:8080

COPY --from=build /app/.output ./.output

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]

